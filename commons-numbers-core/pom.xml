<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.apache.commons</groupId>
    <artifactId>commons-numbers-parent</artifactId>
    <version>1.4-SNAPSHOT</version>
  </parent>

  <artifactId>commons-numbers-core</artifactId>
  <name>Apache Commons Numbers Core</name>

  <description>Basic utilities.</description>

  <properties>
    <!-- The Java Module System Name -->
    <commons.module.name>org.apache.commons.numbers.core</commons.module.name>
    <!-- This value must reflect the current name of the base package. -->
    <commons.osgi.symbolicName>org.apache.commons.numbers.core</commons.osgi.symbolicName>
    <!-- OSGi -->
    <commons.osgi.export>org.apache.commons.numbers.core</commons.osgi.export>
    <!-- Workaround to avoid duplicating config files. -->
    <numbers.parent.dir>${basedir}/..</numbers.parent.dir>
    <!-- Reproducible builds -->
    <project.build.outputTimestamp>${numbers.build.outputTimestamp}</project.build.outputTimestamp>
    <numbers.jira.component>core</numbers.jira.component>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.apache.commons</groupId>
      <artifactId>commons-rng-sampling</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.commons</groupId>
      <artifactId>commons-rng-simple</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>test-jar</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <!-- On Java 8 we cannot test FMA support.
           Activate explicitly (-Pno-fma-support) when building on Java 9+ on
           hardware without FMA support: the FMA code paths cannot be reached. -->
      <id>no-fma-support</id>
      <activation>
        <jdk>(,9)</jdk>
      </activation>
      <properties>
        <!-- No FMA code paths can be reached. Everything else should be tested.
          These values should be raised as the codebase expands.  -->
        <commons.jacoco.instructionRatio>0.95</commons.jacoco.instructionRatio>
        <commons.jacoco.methodRatio>0.96</commons.jacoco.methodRatio>
        <commons.jacoco.branchRatio>0.96</commons.jacoco.branchRatio>
        <commons.jacoco.lineRatio>0.96</commons.jacoco.lineRatio>
        <commons.jacoco.complexityRatio>0.96</commons.jacoco.complexityRatio>
      </properties>
    </profile>
    <profile>
      <!-- On Java 9+ all code paths are tested on hardware with FMA support (default
           JaCoCo coverage ratios). On hardware without FMA support use
           -Pno-fma-support to apply the reduced coverage ratios. -->
      <id>fma-support</id>
      <activation>
        <jdk>[9,)</jdk>
      </activation>
      <properties>
        <!-- Tests repeated with each option to enable/disable FMA.
             Comma-separated Surefire include patterns without spaces:
             a pattern with a leading space is silently ignored. -->
        <numbers.fma.tests>**/DDTest,**/ExtendedPrecisionTest,**/FMASupportTest</numbers.fma.tests>
      </properties>
      <!-- Test the methods that can enable/disable FMA.
           argLine is set by jacoco so pass its settings through using the late
           evaluation syntax @{argLine}: on Java 21+ the commons-parent java-21-up
           profile defines argLine as a property, so ${argLine} would be resolved
           before jacoco sets it and the jacoco agent would be dropped. -->
      <build>
        <plugins>
          <plugin>
            <artifactId>maven-surefire-plugin</artifactId>
            <executions>
              <execution>
                <id>dd-no-use-fma</id>
                <phase>test</phase>
                <goals>
                  <goal>test</goal>
                </goals>
                <configuration>
                  <argLine>@{argLine} -XX:-UseFMA</argLine>
                  <includes>
                    <include>${numbers.fma.tests}</include>
                  </includes>
                </configuration>
              </execution>
              <execution>
                <id>dd-use-fma</id>
                <phase>test</phase>
                <goals>
                  <goal>test</goal>
                </goals>
                <configuration>
                  <argLine>@{argLine} -XX:+UseFMA</argLine>
                  <includes>
                    <include>${numbers.fma.tests}</include>
                  </includes>
                </configuration>
              </execution>
              <execution>
                <id>dd-property-disable</id>
                <phase>test</phase>
                <goals>
                  <goal>test</goal>
                </goals>
                <configuration>
                  <argLine>@{argLine} -Dorg.apache.commons.numbers.core.DD.fma=false</argLine>
                  <includes>
                    <include>${numbers.fma.tests}</include>
                  </includes>
                </configuration>
              </execution>
              <execution>
                <id>dd-property-enable</id>
                <phase>test</phase>
                <goals>
                  <goal>test</goal>
                </goals>
                <configuration>
                  <argLine>@{argLine} -Dorg.apache.commons.numbers.core.DD.fma=true</argLine>
                  <includes>
                    <include>${numbers.fma.tests}</include>
                  </includes>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>

</project>
